{
  "schema_version": 1,
  "design_id": "v7.6-v7-anchored-residual-v1",
  "status": "design_only_not_executed",
  "training_authorized_by_this_audit": false,
  "promotion_supported": false,
  "hypothesis": "A bounded V7-anchored graph correction limits cross-event distortion while retaining useful graph evidence",
  "anchor": {
    "lineage": "rebuilt_v6_v7_recipe",
    "version": "V7",
    "gamma": 1.12,
    "replace_original_combiners": false,
    "retrain_neural_models": false
  },
  "features": [
    "graph_affinity_24h",
    "graph_affinity_72h",
    "graph_centered_24h",
    "graph_centered_72h",
    "log_graph_item_support",
    "graph_history_coverage",
    "graph_edge_coverage",
    "anchor_row_logit",
    "log1p_anchor_event_score_sum",
    "anchor_conditional_probability",
    "anchor_conditional_entropy",
    "history_length_over_20",
    "unseen_user"
  ],
  "excluded_features": [
    "raw_prefix_age",
    "global_prefix_event_count",
    "global_prefix_user_count",
    "calendar_date"
  ],
  "network": {
    "hidden_layers": [
      16
    ],
    "activation": "tanh",
    "output_activation": "tanh",
    "log_odds_radius": 0.25,
    "output_initialization": "zero_weights_and_bias",
    "formula": "sigmoid(logit(anchor) + 0.25*tanh(network(features)))",
    "zero_output_returns_exact_anchor": true,
    "preserve_zero_one_endpoints": true,
    "event_mass_constraint": "none",
    "identity_event_mask": "history_length==0 OR max(graph_edge_coverage across ten candidates)==0"
  },
  "normalization": {
    "fit_on_training_records_only": true,
    "scale_floor": 1e-06,
    "standardized_feature_bound": 5.0,
    "feature_logit_epsilon": 1e-06,
    "entropy_normalizer": "log(10)",
    "event_score_sum_is_probability": false
  },
  "training": {
    "epochs": 32,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "batch_events": 2048,
    "seed": 2026,
    "pair_seed": 5026,
    "early_stopping": false,
    "bce_weight": 0.5,
    "global_row_pair_weight": 0.5,
    "negative_rows_per_positive": 16,
    "negative_pool": "all unclicked candidate rows in the event minibatch, including other users",
    "anchor_divergence": "mean Bernoulli KL(anchor || corrected) over rows",
    "divergence_penalties": [
      0.1,
      1.0,
      10.0
    ]
  },
  "historical_forecasts": {
    "block_hours": 6,
    "first_block_start": 1737374400,
    "combiner_neural_prefix": "latest available cutoff c <= block_start - 6h",
    "combiner_fitting_interval": "[c, block_start)",
    "prediction_neural_prefix": "latest available cutoff d <= block_start",
    "graph_prefix": "d",
